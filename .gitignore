.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.DS_Store

# Prevent accidental commits of Takeout archives or cookie exports in repo root
*.zip
*cookies*.txt
watch-history.html
watch-history.json

# Private user data, exported Takeout files, cookies, and runtime state
data/*
!data/.gitkeep
state/*
!state/.gitkeep
output/*
!output/.gitkeep
